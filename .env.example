# Copy to .env. Every default below runs the whole pipeline with no keys and no
# network, so a fresh clone is runnable before you decide anything.

# --- Keys ---------------------------------------------------------------------
# The conventional names are read directly, so injecting credentials the usual way
# is enough -- there is no second variable to flip. Both are optional.
#
#   ANTHROPIC_API_KEY  console.anthropic.com -> API keys
#                      brief, outline, hook candidates, naming the reference style
#   FAL_KEY            fal.ai/dashboard/keys
#                      keyframes (FLUX) and image-to-video (Kling / Seedance)
#                      also needs: pip install 'styleloom-core[fal]'
#                      With no FAL_KEY the pipeline runs end to end on the mock
#                      video provider and costs nothing -- that is the cheapest
#                      way to test everything except generation quality.
#
# STYLELOOM_-prefixed forms are also accepted and take precedence.
ANTHROPIC_API_KEY=
FAL_KEY=

STYLELOOM_DATA_DIR=data
STYLELOOM_ARCHETYPES_PATH=configs/archetypes.yaml
STYLELOOM_CASTING_PATH=configs/casting.yaml
STYLELOOM_FAL_MODELS_PATH=configs/fal_models.yaml

# --- Providers ----------------------------------------------------------------
# auto (default) resolves to the real provider when its key is present and to the
# offline mock when it is not. Pin to mock to force offline on a keyed machine.
#   llm  : auto | mock | anthropic
#   video: auto | mock | fal
STYLELOOM_LLM_PROVIDER=auto
STYLELOOM_LLM_MODEL=claude-sonnet-5
STYLELOOM_VIDEO_PROVIDER=auto

# These are fal ENDPOINT IDs, not URLs. fal posts to https://fal.run/<endpoint-id>,
# and the model page is https://fal.ai/models/<endpoint-id>. The slashes are fal's
# namespace (vendor/model/tier/task), which is the only reason they are this long.
# Nothing here talks to KlingAI's own Open Platform -- a Kling model name or a
# kling.ai docs URL is not a valid value.
#
# Must be keys in configs/fal_models.yaml. The provider refuses to construct on
# an unknown ID and lists the valid ones, rather than failing at the first
# request after keyframes have already been paid for.
#
# Both defaults are the cheapest endpoint that still does the job, cheapest first:
#
#   text_to_image : fal-ai/flux/dev                             $0.025/MP  DEFAULT
#                   fal-ai/flux-2-flex                          $0.06/MP
#   image_to_video: fal-ai/kling-video/v3/standard/i2v          $0.084/s   DEFAULT
#                   fal-ai/kling-video/v3/pro/i2v               $0.112/s
#                   bytedance/seedance-2.0/image-to-video       $0.303/s
#                   bytedance/seedance-2.0/fast/image-to-video  rate unpublished
#                   fal-ai/veo3.1/fast/image-to-video           rate unpublished
#   (the i2v ids above are abbreviated; use the full ones written below)
#
# v3/standard and v3/pro take identical parameters and have the same 3s floor, so
# Pro buys output quality and nothing the pipeline depends on. Seedance scores
# higher still, but has a 4s floor and no `elements` -- the character reference
# that keeps the cast creator the same person across cuts. Run `styleloom models
# --style <id>` to price these against your own shot count before switching.
#
# kling-video/v3/* is Kling 3.0; kling-video/o3/* is Kling 3.0 Omni, which takes
# image_url rather than start_image_url and has no `elements` on image-to-video.
# Only v3 is specced in configs/fal_models.yaml, and that is a capability call,
# not a price one -- o3/standard costs the same $0.084/s.
STYLELOOM_FAL_T2I_MODEL=fal-ai/flux/dev
STYLELOOM_FAL_I2V_MODEL=fal-ai/kling-video/v3/standard/image-to-video
STYLELOOM_FAL_TIMEOUT_SEC=600

# --- Output ------------------------------------------------------------------
STYLELOOM_WIDTH=720
STYLELOOM_HEIGHT=1280
STYLELOOM_FPS=30

# --- Per-run variation -------------------------------------------------------
# Hook archetype, on-screen creator and background are all drawn from editable
# pools with the same recency-penalised weighting. See configs/casting.yaml.
STYLELOOM_HOOK_CANDIDATE_COUNT=5
STYLELOOM_HOOK_TEMPERATURE=0.9
STYLELOOM_HOOK_TOP_K=3
STYLELOOM_HOOK_SOFTMAX_TEMP=0.8

# How many recent runs of a style are penalised when drawing an archetype, and by
# how much. The penalty is a weight multiplier, so it biases rather than forbids.
# Set the penalty to 0 for hard exclusion, if you need guaranteed variety across
# a batch rather than a strong tendency toward it.
STYLELOOM_HOOK_RECENCY_WINDOW=4
STYLELOOM_HOOK_RECENCY_PENALTY=0.35

# Upper bound only. Endpoints with a lower documented limit (Kling v3 = 1) clamp
# this down automatically.
STYLELOOM_MAX_CONCURRENT_RENDERS=3
