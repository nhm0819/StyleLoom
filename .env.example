# Copy to .env. Every default below runs the whole pipeline with no keys and no
# network, so a fresh clone is runnable before you decide anything.

# --- Keys ---------------------------------------------------------------------
# The conventional names are read directly, so injecting credentials the usual way
# is enough -- there is no second variable to flip. Both are optional.
#
#   ANTHROPIC_API_KEY  console.anthropic.com -> API keys
#                      brief, outline, hook candidates, naming the reference style
#   KLING_ACCESS_KEY   kling.ai/dev -> console -> API keys
#   KLING_SECRET_KEY   keyframes (Kling Image) and image-to-video (Kling Video)
#
# Kling issues a PAIR, not a single token, and both halves are required. The
# access key is public and travels inside the request; the secret key never
# leaves the process and signs a short-lived JWT for every call. There is no
# long-lived bearer token to paste into a header.
#
# With no Kling credentials the pipeline runs end to end on the mock video
# provider and costs nothing -- that is the cheapest way to test everything
# except generation quality.
#
# STYLELOOM_-prefixed forms are also accepted and take precedence.
ANTHROPIC_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

STYLELOOM_DATA_DIR=data
STYLELOOM_ARCHETYPES_PATH=configs/archetypes.yaml
STYLELOOM_CASTING_PATH=configs/casting.yaml
STYLELOOM_KLING_MODELS_PATH=configs/kling_models.yaml

# --- Providers ----------------------------------------------------------------
# auto (default) resolves to the real provider when its key is present and to the
# offline mock when it is not. Pin to mock to force offline on a keyed machine.
#   llm  : auto | mock | anthropic
#   video: auto | mock | kling
STYLELOOM_LLM_PROVIDER=auto
STYLELOOM_LLM_MODEL=claude-sonnet-5
STYLELOOM_VIDEO_PROVIDER=auto

# These are `model_name` values sent in the request body, not URL path segments.
# The official API has one path per capability and selects the model in the body:
#
#   POST https://api-singapore.klingai.com/v1/videos/image2video
#   {"model_name": "kling-v3", "mode": "std", "image": "<base64>", ...}
#
# Must be keys in configs/kling_models.yaml. The provider refuses to construct on
# an unknown name and lists the valid ones, rather than failing at the first
# request after keyframes have already been paid for.
#
#   text_to_image : kling-v3        POST /v1/images/generations
#   image_to_video: kling-v3        POST /v1/videos/image2video      DEFAULT
#                   kling-v3-omni   POST /v1/videos/omni-video/
#
# v3 and v3-omni are different PATHS, not two names on one endpoint -- that is
# the distinction fal's naming hid behind kling-video/{v3,o3}/. Omni is the
# reference-driven tier, but its advantage is elements, which this repo cannot
# use yet (see persona_mode in configs/kling_models.yaml).
STYLELOOM_KLING_T2I_MODEL=kling-v3
STYLELOOM_KLING_I2V_MODEL=kling-v3

# The quality tier. On the official API this is a request field rather than part
# of the endpoint, which is why there is no separate "pro" model name. std is the
# default because the default is what an evaluation run costs.
STYLELOOM_KLING_MODE=std

# api-singapore is the international account system; api-beijing.klingai.com is
# the mainland one. Separate accounts, not regions of one -- switching hosts also
# means switching credentials.
STYLELOOM_KLING_BASE_URL=https://api-singapore.klingai.com

# Generation is asynchronous: a request returns a task id and the video arrives on
# a polling endpoint minutes later. The timeout covers queue time as well as
# inference, and giving up early abandons a task that has already been billed.
STYLELOOM_KLING_TIMEOUT_SEC=900
STYLELOOM_KLING_POLL_INTERVAL_SEC=5

# Kling's concurrency ceiling is a property of the account tier, not the model, so
# unlike the fal registry this cannot be recorded per endpoint. Raise it to match
# your plan; exceeding it fails the whole run.
STYLELOOM_KLING_MAX_CONCURRENCY=1


# --- Output ------------------------------------------------------------------
STYLELOOM_WIDTH=720
STYLELOOM_HEIGHT=1280
STYLELOOM_FPS=30

# --- Per-run variation -------------------------------------------------------
# Hook archetype, on-screen creator and background are all drawn from editable
# pools with the same recency-penalised weighting. See configs/casting.yaml.
STYLELOOM_HOOK_CANDIDATE_COUNT=5
STYLELOOM_HOOK_TEMPERATURE=0.9
STYLELOOM_HOOK_TOP_K=3
STYLELOOM_HOOK_SOFTMAX_TEMP=0.8

# How many recent runs of a style are penalised when drawing an archetype, and by
# how much. The penalty is a weight multiplier, so it biases rather than forbids.
# Set the penalty to 0 for hard exclusion, if you need guaranteed variety across
# a batch rather than a strong tendency toward it.
STYLELOOM_HOOK_RECENCY_WINDOW=4
STYLELOOM_HOOK_RECENCY_PENALTY=0.35

# Upper bound only. Endpoints with a lower documented limit (Kling v3 = 1) clamp
# this down automatically.
STYLELOOM_MAX_CONCURRENT_RENDERS=3
