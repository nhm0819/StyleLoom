# Copy to .env. Defaults below run the whole pipeline with no keys and no network.

STYLELOOM_DATA_DIR=data
STYLELOOM_ARCHETYPES_PATH=configs/archetypes.yaml
STYLELOOM_FAL_MODELS_PATH=configs/fal_models.yaml

# --- LLM: planning, hook generation, style naming -----------------------------
# mock (default, offline) | anthropic
STYLELOOM_LLM_PROVIDER=mock
STYLELOOM_LLM_MODEL=claude-sonnet-4-6
STYLELOOM_ANTHROPIC_API_KEY=

# --- Video: keyframe + image-to-video ----------------------------------------
# mock (default, ffmpeg only) | fal   (fal needs: pip install fal-client)
STYLELOOM_VIDEO_PROVIDER=mock
STYLELOOM_FAL_KEY=

# Must be keys in configs/fal_models.yaml. The provider refuses to start on an
# unknown ID and lists the valid ones, rather than failing at the first request.
#
#   text_to_image : fal-ai/flux-2-flex | fal-ai/flux/dev
#   image_to_video: bytedance/seedance-2.0/fast/image-to-video   (4s floor, ~$0.24/s)
#                   bytedance/seedance-2.0/image-to-video        (4s floor, 1080p)
#                   fal-ai/kling-video/v3/pro/image-to-video     (3s floor, persona support)
#                   fal-ai/kling-video/v3/standard/image-to-video
STYLELOOM_FAL_T2I_MODEL=fal-ai/flux-2-flex
STYLELOOM_FAL_I2V_MODEL=bytedance/seedance-2.0/fast/image-to-video
STYLELOOM_FAL_TIMEOUT_SEC=600

# --- Output ------------------------------------------------------------------
STYLELOOM_WIDTH=720
STYLELOOM_HEIGHT=1280
STYLELOOM_FPS=30

# --- Hook non-determinism ----------------------------------------------------
STYLELOOM_HOOK_CANDIDATE_COUNT=5
STYLELOOM_HOOK_TEMPERATURE=0.9
STYLELOOM_HOOK_TOP_K=3
STYLELOOM_HOOK_SOFTMAX_TEMP=0.8
# Upper bound only. Endpoints with a lower documented limit (Kling v3 = 1)
# clamp this down automatically.
STYLELOOM_MAX_CONCURRENT_RENDERS=3
